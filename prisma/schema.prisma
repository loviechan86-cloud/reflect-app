generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  STUDENT
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime  @default(now())

  // Optional profile fields, mainly filled in for students.
  phone       String?
  dateOfBirth DateTime?
  gender      String?

  paymentStatus PaymentStatus?
  team          String?
  joinDate      DateTime?

  parentName  String?
  parentPhone String?
  parentEmail String?

  school    String?
  gradeYear String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  medicalConditions   String?
  dietaryRestrictions String?

  reflections Reflection[] @relation("StudentReflections")
  comments    Comment[]    @relation("StaffComments")
}

model Reflection {
  id        String   @id @default(cuid())
  content   String
  weekOf    DateTime // Monday of the week this reflection covers
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   User   @relation("StudentReflections", fields: [studentId], references: [id], onDelete: Cascade)

  comments Comment[]

  @@unique([studentId, weekOf])
  @@index([studentId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  reflectionId String
  reflection   Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  staffId String
  staff   User   @relation("StaffComments", fields: [staffId], references: [id])

  @@index([reflectionId])
}
