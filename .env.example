# Postgres connection string. For local dev you can run Postgres in Docker,
# or use a free hosted instance (Neon works well and pairs natively with Vercel).
DATABASE_URL="postgresql://user:password@localhost:5432/reflect"

# Generate with: npx auth secret
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first admin account.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
